# OpenAI 兼容 API Key（务必填自己的密钥，不要把真实 key 提交到仓库）
OPENAI_API_KEY=sk-your-api-key-here

# API 代理地址（可选，默认为 OpenAI 官方地址）
OPENAI_BASE_URL=https://api.deepseek.com
# 模型配置
MODEL_NAME=deepseek-v4-pro
TEMPERATURE=0.7

# MCP 配置（第4期）
MCP_ENABLED=false
MCP_SERVER_URL=http://127.0.0.1:9123/mcp

# Checkpoint 配置（父图持有）
# - backend: memory（仅进程内，重启丢失，不能跨进程）
#             sqlite（磁盘持久化，可跨进程，需 langgraph-checkpoint-sqlite）
#             auto（优先 sqlite，失败回退 memory）
#             postgres（未来扩展，需 langgraph-checkpoint-postgres，暂未实现）
# - CHECKPOINT_PATH 只在 sqlite（文件路径）与 postgres（连接串）下生效
CHECKPOINT_ENABLED=true
CHECKPOINT_BACKEND=memory
CHECKPOINT_PATH=app/sessions/checkpoints.db

# 人工确认（退款/赔偿/投诉升级等敏感操作，中断等待用户确认）
HUMAN_CONFIRMATION_ENABLED=true

# 子图最大循环步数（达到后强制生成回复，防死循环）
SUBGRAPH_MAX_STEPS=5

# 工具调用超时（秒），0 表示不设超时
TOOL_TIMEOUT=30.0
REFUND_STORE_PATH=app/sessions/refunds.db

# Memory 配置（第7期）
MEMORY_ENABLED=true
MEMORY_DIR=app/sessions/memory
MEMORY_USER_ID=default
MAX_LTM_FACTS=50

# Skill 配置（第8期）
SKILLS_ENABLED=true
SKILLS_DIR=skills

# Evaluation 配置（第9期，离线评估工具）
EVAL_DATASET_PATH=app/evaluation/cases.json
EVAL_USE_JUDGE=true
EVAL_PASS_THRESHOLD=0.6

# RAG 配置（第5期）
# Embedding 可独立配置（与 LLM 使用不同提供商，如 DashScope / OpenAI 等）
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_MODEL=text-embedding-v4
KB_DIR=app/agent/rag/knowledge
# 向量后端：numpy（手写余弦，教学透明）/ chroma（向量数据库，生产代表）
RAG_BACKEND=numpy
# NumpyBackend 索引文件
KB_INDEX_PATH=app/sessions/kb_index.json
# ChromaBackend 持久化目录 + collection
CHROMA_PERSIST_DIR=app/sessions/chroma
CHROMA_COLLECTION=ecom_kb

# Adaptive-RAG 配置（魔改：混合检索）
ADAPTIVE_RAG_ENABLED=false
BM25_INDEX_PATH=app/sessions/bm25_index.json
# COHERE_API_KEY=  # 可选，填写后启用 Cohere 重排序

# Token 预算管理（魔改：3层渐进式压缩）
TOKEN_BUDGET=128000
COMPRESSION_LIGHT_PCT=0.50
COMPRESSION_MEDIUM_PCT=0.70
COMPRESSION_AGGRESSIVE_PCT=0.85

# Guardrails 配置（魔改：幻觉检测 + 自纠错）
GUARDRAILS_ENABLED=false

# Milvus 配置（向量数据库）
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# 文档分块配置
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# Prometheus 配置
PROMETHEUS_BASE_URL=http://127.0.0.1:9090
PROMETHEUS_REQUEST_TIMEOUT=10.0

# LangSmith 可观测性（可选）。设置 LANGCHAIN_TRACING_V2=true 时自动接入；
# 不配置则项目正常运行，不受影响。
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ecom-service-agent

# 服务化 API（可选，标准库实现，无额外依赖）
# 启动：python -m app.api.server  默认监听 127.0.0.1:8000
# API_HOST=127.0.0.1
# API_PORT=8000
